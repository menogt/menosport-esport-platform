# Meno Arena environment
# Copy to .env for local development. On Vercel, add every value under Project Settings -> Environment Variables.

# --- Supabase (required) --------------------------------------------------
# Public project URL and anon key. Used by the browser (Vite embeds VITE_* at build time)
# and by the server to verify bearer tokens.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# Service role key (server only, NEVER exposed to the browser). Required for every
# database write: registrations, brackets, results, invites, orders, uploads.
# Without it the API answers with demo data and mutations fail with PRECONDITION_FAILED.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# --- Sessions ---------------------------------------------------------------
JWT_SECRET=<random 32+ char string>

# --- Optional / legacy template values --------------------------------------
# Legacy MySQL path from the original template. Leave unset when using Supabase.
# DATABASE_URL=
# Manus OAuth (unused when Supabase Auth is enabled).
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=
# OWNER_OPEN_ID=
